{
  "$schema": "../schema.json",
  "id": "gpt-5.5-managed-inference",
  "agent": "openclaw",
  "description": "Uses NemoClaw managed inference.local chat completions for GPT-5.5 while leaving experimental OpenClaw Tool Search disabled.",
  "match": {
    "modelIds": ["gpt-5.5", "openai/gpt-5.5"],
    "providerKey": "inference",
    "inferenceApi": "openai-completions",
    "baseUrl": "https://inference.local/v1"
  },
  "effects": {
    "openclawTools": {
      "toolSearch": false
    }
  }
}
